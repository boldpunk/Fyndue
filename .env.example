# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fyndue"
# Separate database used by integration tests (it is reset by the test run)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fyndue_test"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional: set both to enable "Continue with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: set to "false" to close public sign-ups
ALLOW_REGISTRATION="true"

# Optional: Telegram reminders (Settings → Notifications). Create a bot with
# @BotFather, then set the token and its username (without the @).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Only for a public deployment using the webhook (/api/telegram/webhook).
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Protects /api/cron/notifications. Generate with: openssl rand -hex 32
CRON_SECRET=""
