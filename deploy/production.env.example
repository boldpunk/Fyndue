# Fyndue production settings. Copy to `.env` next to docker-compose.yml on
# the server (never commit it) and fill in every value.

# Public address, https only.
APP_URL=https://fyndue.uz

# Port on 127.0.0.1 that nginx/Caddy forwards to. Pick one no other app uses.
FYNDUE_PORT=3100

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# "true" only while you (and family) create accounts, then back to "false".
ALLOW_REGISTRATION=false

# Telegram bot from @BotFather (username without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional "Continue with Google" (redirect URI: https://fyndue.uz/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
