// Fyndue database schema — Phase 1 (foundation).
// Full multi-phase design and rationale: docs/database.md
//
// Conventions:
// - Every user-owned model has `userId` and is always queried with it.
// - Money: Decimal(20, 2). Never floats.
// - Business dates (transactionDate, …): @db.Date — no time zone, cannot drift a day.
// - Instants: @db.Timestamptz(3).
// - CHECK constraints Prisma cannot express live in the migrations (see migration.sql).

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Currency {
  UZS
  USD
  EUR
  RUB
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum AccountType {
  BANK_CARD
  CASH
  SAVINGS
  DEPOSIT
  DIGITAL_WALLET
  OTHER
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  DEBT_PAYMENT
  BALANCE_ADJUSTMENT
  LOAN_DISBURSEMENT
}

enum FlowDirection {
  INFLOW
  OUTFLOW
}

enum TransactionStatus {
  ACTUAL
  EXPECTED
}

enum TransactionSource {
  MANUAL
  IMPORT
  BANK_SYNC
  OCR
  SYSTEM
}

enum DebtType {
  CREDIT
  CAR_LOAN
  INSTALLMENT
  MICROLOAN
  CREDIT_CARD
  MORTGAGE
  PERSONAL
  OTHER
}

enum RepaymentType {
  DIFFERENTIAL
  ANNUITY
  INTEREST_FREE
  MANUAL
  CUSTOM
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  ARCHIVED
}

enum FeeMode {
  NONE
  ADDED_ON_TOP
  DEDUCTED_FROM_DISBURSEMENT
  FINANCED_INTO_DEBT
  CUSTOM
}

enum DayCountConvention {
  MONTHLY_30_360
  ACTUAL_365
  ACTUAL_360
  ACTUAL_ACTUAL
}

enum ScheduleVersionReason {
  INITIAL
  MANUAL_EDIT
  BANK_IMPORT
  EARLY_REPAYMENT
  RESTRUCTURE
  CORRECTION
}

enum ScheduleItemStatus {
  SCHEDULED
  PARTIALLY_PAID
  PAID
  SKIPPED
  RESCHEDULED
}

enum EarlyRepaymentStrategy {
  REDUCE_TERM
  REDUCE_PAYMENT
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringKind {
  EXPENSE
  INCOME
}

enum NotificationType {
  DUE_IN_DAYS
  DUE_TODAY
  OVERDUE
  TEST
}

enum NotificationChannel {
  TELEGRAM
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum TelegramConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
}

// ─── Identity (tables shaped for Better Auth) ────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  baseCurrency  Currency @default(UZS)
  timezone      String   @default("Asia/Tashkent")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions               Session[]
  authAccounts           AuthAccount[]
  settings               UserSettings?
  accounts               Account[]
  categories             Category[]
  transactions           Transaction[]
  auditLogs              AuditLog[]
  debts                  Debt[]
  debtPayments           DebtPayment[]
  scheduleVersions       DebtScheduleVersion[]
  scheduleItems          DebtScheduleItem[]
  recurringTransactions  RecurringTransaction[]
  budgets                Budget[]
  exchangeRates          ExchangeRate[]
  notificationPreference NotificationPreference?
  telegramConnection     TelegramConnection?
  notificationLogs       NotificationLog[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth's "account" (credential / OAuth link). Renamed so it cannot be
/// confused with the financial Account model. Password hashes are written by
/// Better Auth only.
model AuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  theme            Theme    @default(SYSTEM)
  locale           String   @default("en-US")
  defaultAccountId String?
  weekStartsOn     Int      @default(1)
  dueSoonDays      Int      @default(7)
  urgentDays       Int      @default(2)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Money ────────────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  currency       Currency
  openingBalance Decimal     @db.Decimal(20, 2)
  /// Denormalised: openingBalance + Σ inflow − Σ outflow over actual,
  /// non-voided transactions. Only changed inside the same DB transaction
  /// as the transaction that moves it.
  currentBalance Decimal     @db.Decimal(20, 2)
  includeInTotal Boolean     @default(true)
  bank           String?
  icon           String?
  color          String?
  sortOrder      Int         @default(0)
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  debtPayments          DebtPayment[]
  disbursedDebts        Debt[]
  recurringTransactions RecurringTransaction[]

  @@index([userId, isArchived])
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  type       CategoryType
  icon       String
  color      String?
  isDefault  Boolean      @default(false)
  /// System categories (e.g. "Debt Payments") are used by the app itself
  /// and cannot be archived.
  isSystem   Boolean      @default(false)
  isArchived Boolean      @default(false)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]

  @@unique([userId, type, name])
  @@index([userId, type, isArchived, sortOrder])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  accountId       String
  categoryId      String?
  type            TransactionType
  direction       FlowDirection
  status          TransactionStatus @default(ACTUAL)
  /// Always > 0: the real movement of money on the account.
  amount          Decimal           @db.Decimal(20, 2)
  /// Always equals the account's currency.
  currency        Currency
  transactionDate DateTime          @db.Date
  merchant        String?
  note            String?
  /// Shared by both legs of a transfer.
  transferGroupId String?
  /// Set on DEBT_PAYMENT and LOAN_DISBURSEMENT rows.
  debtId          String?
  /// 1:1 with the DebtPayment whose real account movement this row records.
  debtPaymentId   String?           @unique
  /// Set when this row records an occurrence of a recurring rule. One live
  /// (non-voided) row per rule and date (partial unique index).
  recurringId     String?
  occurrenceDate  DateTime?         @db.Date
  source          TransactionSource @default(MANUAL)
  externalId      String?
  /// Idempotency key generated by the form; prevents double submits.
  clientRequestId String?
  voidedAt        DateTime?         @db.Timestamptz(3)
  voidReason      String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  debt        Debt?                 @relation(fields: [debtId], references: [id], onDelete: Restrict)
  debtPayment DebtPayment?          @relation(fields: [debtPaymentId], references: [id], onDelete: Restrict)
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([userId, transactionDate])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([transferGroupId])
  @@index([recurringId])
}

// ─── Debts (docs/debt-engine.md) ─────────────────────────────────────────────

model Debt {
  id                      String             @id @default(cuid())
  userId                  String
  name                    String
  lender                  String?
  type                    DebtType
  repaymentType           RepaymentType
  currency                Currency
  status                  DebtStatus         @default(ACTIVE)
  /// Contract / requested principal.
  originalPrincipal       Decimal            @db.Decimal(20, 2)
  /// What the schedule amortises and progress is measured against:
  /// original principal, or original + fee when FINANCED_INTO_DEBT.
  principalBasis          Decimal            @db.Decimal(20, 2)
  /// Denormalised: principalBasis − paidBeforeTracking − Σ principal of
  /// non-reversed payments. Never below zero (CHECK).
  currentPrincipal        Decimal            @db.Decimal(20, 2)
  /// Principal repaid before Fyndue tracked the debt (no account movement).
  paidBeforeTracking      Decimal            @default(0) @db.Decimal(20, 2)
  netAmountReceived       Decimal?           @db.Decimal(20, 2)
  /// Annual percent, e.g. 24.000000.
  annualInterestRate      Decimal?           @db.Decimal(9, 6)
  dayCountConvention      DayCountConvention @default(MONTHLY_30_360)
  roundingScale           Int                @default(2)
  feeMode                 FeeMode            @default(NONE)
  originationFeeAmount    Decimal?           @db.Decimal(20, 2)
  contractTotalRepayment  Decimal?           @db.Decimal(20, 2)
  /// The lender gave only amounts due; interest is never invented.
  knownTotalRepayment     Boolean            @default(false)
  startDate               DateTime           @db.Date
  endDate                 DateTime?          @db.Date
  firstPaymentDate        DateTime?          @db.Date
  paymentDay              Int?
  originalTermMonths      Int?
  currentProjectedEndDate DateTime?          @db.Date
  activeScheduleVersionId String?            @unique
  disbursementAccountId   String?
  notes                   String?
  clientRequestId         String?
  createdAt               DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(3)

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  disbursementAccount   Account?              @relation(fields: [disbursementAccountId], references: [id], onDelete: SetNull)
  activeScheduleVersion DebtScheduleVersion?  @relation("ActiveScheduleVersion", fields: [activeScheduleVersionId], references: [id], onDelete: SetNull)
  scheduleVersions      DebtScheduleVersion[] @relation("DebtVersions")
  scheduleItems         DebtScheduleItem[]
  payments              DebtPayment[]
  transactions          Transaction[]

  @@unique([userId, clientRequestId])
  @@index([userId, status])
}

/// Immutable header of one schedule version. Versions are never deleted.
model DebtScheduleVersion {
  id            String                @id @default(cuid())
  userId        String
  debtId        String
  version       Int
  reason        ScheduleVersionReason
  note          String?
  effectiveFrom DateTime?             @db.Date
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt              Debt               @relation("DebtVersions", fields: [debtId], references: [id], onDelete: Cascade)
  activeFor         Debt?              @relation("ActiveScheduleVersion")
  items             DebtScheduleItem[] @relation("ItemVersion")
  supersededItems   DebtScheduleItem[] @relation("ItemSupersededBy")
  resultingPayments DebtPayment[]

  @@unique([debtId, version])
  @@index([userId, debtId])
}

model DebtScheduleItem {
  id                    String             @id @default(cuid())
  userId                String
  debtId                String
  scheduleVersionId     String
  installmentNumber     Int
  dueDate               DateTime           @db.Date
  openingPrincipal      Decimal            @db.Decimal(20, 2)
  plannedPrincipal      Decimal            @db.Decimal(20, 2)
  plannedInterest       Decimal            @db.Decimal(20, 2)
  plannedFees           Decimal            @db.Decimal(20, 2)
  plannedTotal          Decimal            @db.Decimal(20, 2)
  closingPrincipal      Decimal            @db.Decimal(20, 2)
  /// Denormalised from non-reversed payments on this line.
  paidPrincipal         Decimal            @default(0) @db.Decimal(20, 2)
  paidInterest          Decimal            @default(0) @db.Decimal(20, 2)
  paidFees              Decimal            @default(0) @db.Decimal(20, 2)
  paidTotal             Decimal            @default(0) @db.Decimal(20, 2)
  status                ScheduleItemStatus @default(SCHEDULED)
  /// false once the figures come from the bank or the user.
  isEstimate            Boolean            @default(true)
  /// Exactly one current line per installment number (partial unique index).
  isCurrent             Boolean            @default(true)
  supersededByVersionId String?
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt         Debt                 @relation(fields: [debtId], references: [id], onDelete: Cascade)
  version      DebtScheduleVersion  @relation("ItemVersion", fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  supersededBy DebtScheduleVersion? @relation("ItemSupersededBy", fields: [supersededByVersionId], references: [id], onDelete: SetNull)
  payments     DebtPayment[]

  @@index([userId, dueDate, status])
  @@index([debtId, isCurrent, dueDate])
  @@index([scheduleVersionId])
}

model DebtPayment {
  id                         String                  @id @default(cuid())
  userId                     String
  debtId                     String
  scheduleItemId             String?
  accountId                  String
  paymentDate                DateTime                @db.Date
  amountAppliedToDebt        Decimal                 @db.Decimal(20, 2)
  actualAccountDebit         Decimal                 @db.Decimal(20, 2)
  principalAmount            Decimal                 @default(0) @db.Decimal(20, 2)
  interestAmount             Decimal                 @default(0) @db.Decimal(20, 2)
  originationFeeAmount       Decimal                 @default(0) @db.Decimal(20, 2)
  paymentProcessingFeeAmount Decimal                 @default(0) @db.Decimal(20, 2)
  penaltyAmount              Decimal                 @default(0) @db.Decimal(20, 2)
  otherFeeAmount             Decimal                 @default(0) @db.Decimal(20, 2)
  isEarlyRepayment           Boolean                 @default(false)
  earlyRepaymentStrategy     EarlyRepaymentStrategy?
  resultingScheduleVersionId String?
  note                       String?
  clientRequestId            String?
  reversedAt                 DateTime?               @db.Timestamptz(3)
  reversalReason             String?
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)

  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt                     Debt                 @relation(fields: [debtId], references: [id], onDelete: Cascade)
  scheduleItem             DebtScheduleItem?    @relation(fields: [scheduleItemId], references: [id], onDelete: Restrict)
  account                  Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  resultingScheduleVersion DebtScheduleVersion? @relation(fields: [resultingScheduleVersionId], references: [id], onDelete: SetNull)
  transaction              Transaction?

  @@unique([userId, clientRequestId])
  @@index([userId, paymentDate])
  @@index([debtId, reversedAt])
}

// ─── Planning (Phase 4) ───────────────────────────────────────────────────────

/// A rule such as "Internet, 150,000 on the 5th of every month". Occurrences
/// are computed (lib/finance/recurrence.ts) and appear as planned events; they
/// never become actual transactions without the user recording them.
model RecurringTransaction {
  id             String              @id @default(cuid())
  userId         String
  name           String
  kind           RecurringKind
  accountId      String
  categoryId     String?
  amount         Decimal             @db.Decimal(20, 2)
  /// Always the account's currency.
  currency       Currency
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  startDate      DateTime            @db.Date
  endDate        DateTime?           @db.Date
  isSubscription Boolean             @default(false)
  isActive       Boolean             @default(true)
  note           String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId, isActive])
}

/// Monthly budget: overall (categoryId null) or per expense category.
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(20, 2)
  currency   Currency
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, year, month])
}

/// Manual exchange rate entered by the user: 1 fromCurrency = rate toCurrency.
/// Fyndue never fetches or invents rates (SPEC §46).
model ExchangeRate {
  id            String   @id @default(cuid())
  userId        String
  fromCurrency  Currency
  toCurrency    Currency
  rate          Decimal  @db.Decimal(20, 8)
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromCurrency, toCurrency, effectiveDate])
  @@index([userId, fromCurrency, toCurrency])
}

// ─── Notifications (Phase 5, docs/telegram.md) ─────────────────────────────────

model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  telegramEnabled   Boolean  @default(true)
  inAppEnabled      Boolean  @default(true)
  /// Remind this many days before a due date (default 7, 3, 1).
  notifyDaysBefore  Int[]    @default([7, 3, 1])
  notifyOnDueDate   Boolean  @default(true)
  notifyWhenOverdue Boolean  @default(true)
  /// After the first overdue reminder, repeat every N days.
  overdueRepeatDays Int      @default(3)
  /// "HH:MM" in the user's time zone; the window may wrap midnight.
  quietHoursStart   String?  @default("22:00")
  quietHoursEnd     String?  @default("09:00")
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramConnection {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  telegramChatId          String?                  @unique
  telegramUsername        String?
  /// SHA-256 of the one-time code; the code itself is never stored.
  connectionCodeHash      String?                  @unique
  connectionCodeExpiresAt DateTime?                @db.Timestamptz(3)
  connectedAt             DateTime?                @db.Timestamptz(3)
  status                  TelegramConnectionStatus @default(PENDING)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per reminder. The unique deduplicationKey is claimed *before*
/// sending, so running the job twice can never send twice.
model NotificationLog {
  id                String              @id @default(cuid())
  userId            String
  debtId            String?
  scheduleItemId    String?
  type              NotificationType
  channel           NotificationChannel
  deduplicationKey  String              @unique
  scheduledAt       DateTime            @db.Timestamptz(3)
  sentAt            DateTime?           @db.Timestamptz(3)
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0)
  externalMessageId String?
  failureReason     String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([scheduleItemId])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Append-only. Written inside the same DB transaction as the change.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
